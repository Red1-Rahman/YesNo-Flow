{
  "name": "yesno-flow",
  "version": "0.1.0",
  "private": true,
  "description": "Visual AI workflow builder. Each node is a YES/NO decision step, executed by Inngest and drawn with React Flow.",
  "license": "Apache-2.0",
  "author": "Redwan Rahman",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "next dev",
    "dev:inngest": "npx --yes inngest-cli@latest dev -u http://localhost:3000/api/inngest",
    "dev:all": "concurrently -k -n next,inngest -c cyan,magenta \"npm:dev\" \"npm:dev:inngest\"",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --pool=threads",
    "test:watch": "vitest --pool=threads",
    "check": "npm run typecheck && npm run lint && npm run test",
    "format": "prettier --write ."
  },
  "dependencies": {
    "@xyflow/react": "^12.8.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "inngest": "^3.40.0",
    "lucide-react": "^0.540.0",
    "nanoid": "^5.1.5",
    "next": "^16.4.2",
    "openai": "^5.12.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.3.1",
    "yaml": "^2.9.1",
    "zod": "^3.25.76",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "@tailwindcss/postcss": "^4.1.0",
    "@types/node": "^22.15.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "concurrently": "^9.2.0",
    "eslint": "^10.0.0",
    "prettier": "^3.6.0",
    "tailwindcss": "^4.1.0",
    "tw-animate-css": "^1.3.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.40.0",
    "vitest": "^5.0.5"
  },
  "overrides": {
    "node-domexception": "npm:@nolyfill/domexception@^1.0.28",
    "serialize-error-cjs": "^0.3.0",
    "glob": "^13.0.6"
  },
  "allowScripts": {
    "protobufjs": true
  }
}
