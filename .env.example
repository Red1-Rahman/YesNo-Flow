# OpenRouter (OpenAI-compatible API)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://openrouter.ai/api/v1
OPENAI_MODEL=openrouter/free

# Inngest dev server (local)
INNGEST_DEV=1
INNGEST_BASE_URL=http://localhost:8288

# Inngest cloud (production only)
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Safety limit for node visits in a single run (guards against cycles)
WORKFLOW_MAX_STEPS=25

# Per-node context retrieval
CONTEXT_DIR=./context
CONTEXT_MAX_FILE_BYTES=262144
CONTEXT_MAX_SOURCE_CHARS=8000
CONTEXT_MAX_TOTAL_CHARS=12000
CONTEXT_UPLOADS_ENABLED=
LLM_STRUCTURED_OUTPUT=auto
